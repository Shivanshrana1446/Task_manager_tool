{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Project & Task Management System - Backend API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
