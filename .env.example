# Compose-level configuration for docker-compose.prod.yml.
# Copy to `.env` and adjust as needed: `cp .env.example .env`
#
# App runtime secrets (JWT, Cloudinary, SMTP, ...) still live in
# backend/.env and frontend/.env — see their own .env.example files.

# Public port the frontend (nginx) is published on.
FRONTEND_PORT=8080

# Build-time values baked into the frontend bundle. Defaults proxy through
# nginx to the backend container, so they rarely need to change.
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/

# MongoDB root credentials. Leave both blank to run Mongo without auth
# (fine for a single-host demo/staging deployment). Set both to enable
# authentication — and update MONGODB_URI below to match.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Override only if MongoDB auth is enabled above, e.g.:
# MONGODB_URI=mongodb://<user>:<password>@mongo:27017/task_manager?authSource=admin
MONGODB_URI=mongodb://mongo:27017/task_manager
